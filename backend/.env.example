APP_NAME=Crime Intelligence India API
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://crime:crime@db:5432/crime_intelligence
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# Starter feeds for local research. Review publisher terms before redistribution.
NEWS_RSS_FEEDS=https://feeds.feedburner.com/ndtvnews-india-news,https://timesofindia.indiatimes.com/rssfeeds/-2128936835.cms
# Optional provider key. Check your plan and publisher licensing before use.
NEWSAPI_KEY=
MAX_ARTICLES_PER_FEED=50
INGESTION_INTERVAL_MINUTES=60
# Scheduling runs in the dedicated worker container.
SCHEDULER_ENABLED=false
REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY=change-me
DEMO_ENABLED=false
